{
	"name": "nuxt3-website",
	"version": "0.01",
	"description": "使用nuxt3构建web应用",
	"private": true,
	"packageManager": "pnpm@9.12.3",
	"engines": {
		"node": "^18.20.*",
		"pnpm": ">=9.0.0 <10.0.0"
	},
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:prettier": "prettier --write \"pages/**/*.{js,ts,json,tsx,css,less,scss,vue,html,md}\"",
		"commit": "git add . && git-cz",
		"pre-commit": "lint-staged"
	},
	"dependencies": {
		"@docsearch/css": "3.6.2",
		"@docsearch/js": "3.6.2",
		"@nuxt/eslint": "0.5.7",
		"@pinia/nuxt": "0.5.5",
		"element-plus": "2.8.4",
		"gsap": "3.12.5",
		"less": "4.2.0",
		"nuxt": "3.13.2",
		"pinia": "2.2.4",
		"pinia-plugin-persistedstate": "4.1.1",
		"vue": "3.5.8",
		"vue-router": "4.4.5"
	},
	"devDependencies": {
		"@commitlint/cli": "17.8.1",
		"@commitlint/config-angular": "17.8.1",
		"@commitlint/cz-commitlint": "17.8.1",
		"@element-plus/nuxt": "1.0.10",
		"@iconify/vue": "4.1.2",
		"@nuxtjs/sitemap": "6.1.1",
		"@nuxtjs/tailwindcss": "6.12.1",
		"@typescript-eslint/eslint-plugin": "8.8.0",
		"@typescript-eslint/parser": "8.8.0",
		"@typescript-eslint/utils": "8.8.0",
		"@vueuse/core": "11.1.0",
		"@vueuse/nuxt": "11.1.0",
		"commitizen": "4.3.1",
		"dayjs-nuxt": "2.1.11",
		"eslint": "9.11.1",
		"husky": "9.1.6",
		"lint-staged": "15.2.10",
		"prettier": "3.3.3",
		"typescript": "5.6.2"
	},
	"pnpm": {
		"overrides": {
			"nuxi": "3.13.2",
			"@nuxt/kit": "3.13.2",
			"@nuxt/schema": "3.13.2",
			"@nuxt/devtools": "1.5.0",
			"@nuxt/devtools-kit": "1.5.0",
			"unplugin": "1.14.1",
			"unctx": "2.3.1",
			"unimport": "3.12.0",
			"vite": "5.4.7",
			"magicast": "0.3.5",
			"eslint": "9.11.1",
			"@typescript-eslint/eslint-plugin": "8.8.0",
			"@typescript-eslint/parser": "8.8.0",
			"@typescript-eslint/utils": "8.8.0",
			"typescript": "5.6.2"
		}
	},
	"lint-staged": {
		"*.{js,ts,vue,jsx,tsx}": [
			"eslint --cache --fix"
		],
		"*.{js,jsx,ts,tsx,md,html,css,lees,scss,sass}": "prettier --write"
	},
	"config": {
		"commitizen": {
			"path": "@commitlint/cz-commitlint"
		}
	},
	"gitHooks": {
		"pre-commit": "lint-staged"
	}
}
